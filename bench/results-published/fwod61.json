    {
      "id": "03-create",
      "instruction": "In this Odoo 17 app, create a new sales quotation: go to the Sales app > Orders > Quotations, click {{02-create.button}}, and set the Customer field to '{{runid}} Bench Customer' — it's an autocomplete dropdown, so actually select the matching option from the dropdown that appears. Then add ONE order line: pick any product from the catalogue (e.g. type a few letters and choose an actual option from the product dropdown), set Quantity to 3. Save the quotation. Then report: (a) the product name you chose, (b) the Unit Price the app auto-filled on the line, and (c) the Untaxed Amount shown on the quotation. Do not wait for network idle.",
      "outputs": [
        "customer",
        "customer_city_shown_on_form",
        "product_chosen_dropdown_option",
        "quantity_set",
        "unit_price_observed_presave",
        "untaxed_amount_observed_presave",
        "tax_20_observed",
        "total_observed_presave",
        "save_blocked_by_modal",
        "post_save_line_state",
        "quotation_saved",
        "verified_source"
      ],
      "recorded": {
