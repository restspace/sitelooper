    {
      "id": "02-create",
      "instruction": "In Odoo (already signed in as admin), go to the Sales app and create a new quotation for the customer '{{runid}} Bench Customer' (choose the customer from the autocomplete dropdown so it is actually selected, not just typed). Add exactly ONE order line: pick any product from the product catalogue (choose it from the product autocomplete dropdown so it is actually selected), with quantity 3. Let Odoo fill in the unit price automatically from the product. Save the quotation. Report: (a) the product name you chose, (b) the unit price Odoo filled in on the line, and (c) the Untaxed Amount the quotation shows. Do not wait for network idle; wait for concrete page state.",
      "outputs": [
        "product_name",
        "unit_price",
        "quantity",
        "line_subtotal",
        "untaxed_amount",
        "tax_20_percent",
        "total",
        "customer",
        "saved",
        "blocking_modal"
