    {
      "id": "03-create",
      "instruction": "In the Odoo Sales app, create a new quotation: click Sales > Quotations (Orders), click New/Create, and in the Customer field type '{{runid}} Bench Customer' and select the matching option from the autocomplete dropdown (the value only counts if chosen from the dropdown). Then in the Order Lines section add ONE order line: click to add a product, type any product name from the catalogue (e.g. a real product that exists) and select it from the autocomplete dropdown, and set its Quantity to 3. Do not add any second line. Save the quotation. Then report: (a) the product name you chose, (b) the Unit Price the app filled in for that line, and (c) the Untaxed Amount shown in the quotation's totals. Do not wait for network idle; wait for concrete page state.",
      "outputs": [
        "product_name_selected",
        "unit_price_observed",
        "quantity_set",
        "row_subtotal_before_qty_edit",
        "untaxed_amount",
        "rejected_first_product",
        "customer_field",
        "saved",
        "save_button_clicks"
      ],
      "recorded": {
